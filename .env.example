# Google Gemini API key (free tier). Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model used for triage / account-brief generation calls
GEMINI_MODEL=gemini-1.5-flash

# Model used for LLM-as-judge scoring in the eval harness (can be the same model)
GEMINI_JUDGE_MODEL=gemini-1.5-flash

# Generation settings — kept fixed for reproducibility, override only for experiments
GEMINI_TEMPERATURE=0
